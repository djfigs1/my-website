---
import Projects from "../components/projects/Projects.astro";
import WelcomeBanner from "../components/WelcomeBanner.astro";
import Group from "../layouts/Group.astro";
import Page from "../layouts/Page.astro";
import PageCenter from "../layouts/PageCenter.astro";
---

<Page>
  <PageCenter>
    <Group gap="64px">
      <WelcomeBanner />
      <div class="welcome-content">
        <span>
          I graduated with an undergraduate degree in computer science and a
          minor in cybersecurity from the University of Maryland: College Park.
          I have had a life-long passion for software development and creatively
          using technology to solve problems. Through personal projects, I have
          self-taught myself in many different areas such as mobile app
          development, virtual reality applications, robotics, games,
          cybersecurity, and backend software.
        </span>
        <span>
          I am extremely passionate about the emerging "XR" field (virtual
          reality, augmented reality, and mixed reality) and served as President
          for the <a href="https://xr.umd.edu">XR Club at UMD</a> as well as <a
            href="https://icxr.org">Intercollegiate XR</a
          >. I enjoyed hosting workshops to educate club members about using the
          Unity game engine and other specialized topics.
        </span>
      </div>
      <Group gap="32px">
        <h2>My Pojects</h2>
        <Projects />
      </Group>
    </Group>
  </PageCenter>
</Page>
<style>
  #resume {
    width: 100%;
    aspect-ratio: 8.5 / 11;
    background-color: white;
    border-radius: 0.5rem;
  }

  a {
    font-weight: 700;
  }

  h1 {
    margin-top: 1em;
    margin-bottom: 1em;
  }

  h2 {
    font-size: 1.75em;
  }

  .yt {
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .welcome-content {
    display: flex;
    flex-direction: column;
    gap: 1.5em;
    text-align: justify;
    font-size: 1.25em;
    line-height: 1.5em;
  }
</style>
