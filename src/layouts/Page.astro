---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Fox from "../assets/img/fox.png";
import { getImage } from "astro:assets";

const FoxImage = await getImage({ src: Fox });
const FoxHref = FoxImage.src;
---

<!doctype html>
<html>
  <head>
    <title>D.J. Figueroa</title>
    <meta name="theme-color" content="#110000" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/png" sizes="any" href={FoxHref} />
    <link rel="apple-touch-icon" type="image/png" href={FoxHref} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-NT0WWDP3GH"
  ></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());

    gtag("config", "G-NT0WWDP3GH");
  </script>
</html>
<style>
  :root {
    --dj-red: #f73d3d;
    --dj-orange: #e6611a;
    --dj-yellow: #ffc847;
    --dj-purple: #ac4bfb;
    --dj-blue: #0089fc;
    --card-color: #000000;

    --dj-gradient:
      radial-gradient(circle at 20% 30%, var(--dj-red) 0%, transparent 35%),
      radial-gradient(circle at 80% 20%, var(--dj-yellow) 0%, transparent 40%),
      radial-gradient(circle at 70% 80%, var(--dj-purple) 0%, transparent 45%),
      radial-gradient(circle at 15% 75%, var(--dj-blue) 0%, transparent 38%),
      linear-gradient(var(--dj-red), var(--dj-purple));

    --primary: var(--dj-red);
    --secondary: var(--dj-red);
    --text: rgb(237, 237, 237);
    --background: #111111;
    --dark-background: #111111;
  }

  body {
    margin: 0;
    box-sizing: border-box;
    font-family: "Outfit", sans-serif;
    font-size: 1.1em;
    background: var(--dark-background);
    color: var(--text);
    position: relative;
  }

  @media (orientation: portrait) {
    main::before {
      height: 8rem;
    }
  }

  main {
    min-height: 100vh;
  }
</style>

<style is:global>
  *,
  *:before,
  *:after {
    box-sizing: inherit;
  }
  a {
    color: var(--secondary);
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6,
  p {
    margin: 0;
    padding: 0;
  }

  h1 {
    color: var(--primary);
  }
</style>
