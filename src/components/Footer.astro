---
import Fox from "../assets/img/fox.png";
import { Image } from "astro:assets";
import Group from "../layouts/Group.astro";
import SocialLinks from "./socials/SocialLinks.astro";
---

<footer>
  <div class="footer-inner">
    <Group alignItems="center">
      Hecho con amor
      <SocialLinks />
      <p class="copyright">
        &copy; {new Date().getFullYear()} D.J. Figueroa. All rights reserved.
      </p>
    </Group>
  </div>
</footer>
<style>
  footer {
    display: flex;
    justify-content: center;
    padding-top: 2rem;
    padding-bottom: 2rem;
    background-color: var(--dark-background);
    min-width: 100%;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .copyright {
    font-size: 0.75rem;
    color: rgba(237, 237, 237, 0.7);
  }
</style>
